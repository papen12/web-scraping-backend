# ── Scraper Inmobiliario — Variables de entorno ──────────────────────────────
# Copiar este archivo a .env y completar los valores.
#   cp .env.example .env

# API key de Groq para inferencia LLM (obligatoria para auto-generación de reglas)
GROQ_API_KEY=gsk_tu_api_key_aqui

# URL base del monolito donde se envían las propiedades via POST
MONOLITO_URL=http://localhost:8000

# Cantidad máxima de contextos de navegador concurrentes
MAX_WORKERS=4

# true = asyncio.gather (paralelo) | false = loop secuencial
PARALELO=true

# Nivel de logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Ruta al archivo índice de reglas Steel/Scheme
REGLAS_PATH=reglas/reglas.toml
