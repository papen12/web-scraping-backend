    "html": "<!DOCTYPE html><html lang=\"es\"><head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>UltraCasas — Una pausa necesaria</title>\n  <meta name=\"robots\" content=\"noindex,nofollow\">\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n  <link href=\"https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,400;0,600;0,700;1,700&amp;display=swap\" rel=\"stylesheet\">\n  <style>\n    :root{\n      --ink:#111;\n      --muted:#5f6b7a;\n      --accent:#6a7cff; \n      --bg:#ffffff;\n      --max:1200px;\n    }\n    *{ box-sizing:border-box; }\n    html,body{ height:100%; }\n    body{\n      margin:0;\n      font-family:\"Open Sans\", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;\n      background:var(--bg);\n      color:var(--ink);\n      overflow-x:hidden;\n    }\n\n    .stage{\n      position:relative;\n      min-height:100vh;\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      padding:48px 18px;\n    }\n    \n    .cloud{\n      position:absolute;\n      width:min(180px, 22vw);\n      opacity:0.55;\n      pointer-events:none;\n      user-select:none;\n    }\n    .cloud.c1{ left:4%; top:18%; }\n    .cloud.c2{ left:28%; top:34%; width:min(160px, 20vw); opacity:0.4; }\n    .cloud.c3{ right:6%; top:22%; width:min(210px, 26vw); opacity:0.5; }\n\n    .wrap{\n      width:min(var(--max), 100%);\n      display:flex;\n      align-items:center;\n      justify-content:space-between;\n      gap:40px;\n    }\n\n    .copy{\n      flex: 1 1 520px;\n      max-width:560px;\n    }\n    h1{\n      margin:0 0 14px 0;\n      font-size: clamp(28px, 3.2vw, 44px);\n      line-height:1.12;\n      color:var(--accent);\n      font-weight:700;\n      letter-spacing:-0.2px;\n    }\n    p{\n      margin:0 0 10px 0;\n      font-size: clamp(15px, 1.2vw, 18px);\n      line-height:1.45;\n      color:var(--ink);\n      font-weight:400;\n    }\n    .emph{\n      font-style:italic;\n      font-weight:700;\n      margin-top:10px;\n      font-size: clamp(18px, 1.7vw, 22px);\n    }\n    .brand{\n      margin-top:26px;\n      display:flex;\n      align-items:center;\n      gap:14px;\n    }\n    .brand img{\n      width:min(280px, 62vw);\n      height:auto;\n      display:block;\n    }\n\n    .art{\n      flex: 0 0 auto;\n      display:flex;\n      justify-content:flex-end; \n      align-items:center;\n      width:min(620px, 52vw);     \n    }\n\n    .dog{\n      position:static;         \n      display:block;\n      width:100%;              \n      max-width:620px;\n      height:auto;\n      border-radius:0;          \n      box-shadow:none;          \n      background:transparent;\n    }\n\n\n    /* mobile */\n    @media (max-width: 860px){\n      .wrap{\n        flex-direction:column;\n        align-items:center;\n        text-align:center;\n      }\n      .copy{\n        flex: 1 1 320px;\n        max-width:720px;\n        display:flex;              \n        flex-direction:column;     \n        align-items:center;        \n      }\n      h1{ margin-top: 40px; } \n      .brand{\n        order:-1;                  \n        margin: 0 0 14px;          \n        justify-content:center;\n      }\n      .art{ width:100%; justify-content:center;}\n      .artWrap{ aspect-ratio: 4 / 3; }\n      .dog{\n        display:block;\n        margin: 0 auto;            \n        width: min(520px, 92vw);   \n        height:auto;\n      }\n      .cloud.c2{ display:none; }\n      \n      .stage{\n        padding: 22px 14px 28px;   \n      }\n      .wrap{\n        gap: 18px;                 \n      }\n      .copy p:last-of-type{\n        margin-bottom: 0;          \n      }\n    }\n    @media (max-width: 420px){\n      .stage{ padding:28px 14px 90px; }\n      .bar{ height:56px; }\n    }\n  </style>\n</head>\n\n<body>\n  <div class=\"stage\">\n    <!-- nubes decorativas -->\n    <img class=\"cloud c1\" src=\"assets/cloud.png\" alt=\"\" aria-hidden=\"true\">\n    <img class=\"cloud c2\" src=\"assets/cloud.png\" alt=\"\" aria-hidden=\"true\">\n    <img class=\"cloud c3\" src=\"assets/cloud.png\" alt=\"\" aria-hidden=\"true\">\n\n    <main class=\"wrap\" role=\"main\" aria-label=\"UltraCasas en pausa\">\n      <section class=\"copy\" aria-label=\"Mensaje\">\n        <h1>Una pausa necesaria</h1>\n        <p>UltraCasas entra en una pausa estratégica en respuesta al contexto actual. Gracias por haber sido parte de este camino.</p>\n        <p class=\"emph\">Volveremos pronto con un mejor servicio.</p>\n\n        <div class=\"brand\" aria-label=\"Marca\">\n          <img src=\"assets/logo.png\" alt=\"UltraCasas\">\n        </div>\n      </section>\n\n      <section class=\"art\" aria-label=\"Ilustración\">\n          <!-- perrito -->\n          <img class=\"dog\" src=\"assets/dog.jpeg\" alt=\"Mascota de UltraCasas sentada en la grúa\">\n      </section>\n    </main>\n  </div>\n\n\n</body></html>"
